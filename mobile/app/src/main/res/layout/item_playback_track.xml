<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_track_card">

    <!-- Track Icon -->
    <ImageView
        android:id="@+id/imgTrackIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:tint="#0ea5e9"
        android:contentDescription="Track Icon" />

    <!-- Labels Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <!-- Primary Label: Structural -->
        <TextView
            android:id="@+id/txtStructuralLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Part 1, Staff 1"
            android:textColor="#f8fafc"
            android:textStyle="bold"
            android:textSize="14sp" />

        <!-- Secondary Label Row: SATB with confidence badges -->
        <LinearLayout
            android:id="@+id/layoutSatbBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtSatbLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soprano"
                android:textColor="#0ea5e9"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtSatbConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRMED"
                android:textColor="#10b981"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_confirmed"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Mute Button -->
    <ImageButton
        android:id="@+id/btnMute"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_lock_silent_mode"
        android:background="@drawable/bg_control_button"
        android:tint="#94a3b8"
        android:contentDescription="Mute Track"
        android:layout_marginEnd="8dp" />

    <!-- Solo Button -->
    <ImageButton
        android:id="@+id/btnSolo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/btn_star_big_off"
        android:background="@drawable/bg_control_button"
        android:tint="#94a3b8"
        android:contentDescription="Solo Track" />

</LinearLayout>
